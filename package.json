{
  "name": "@thatapicompany/overture-maps-mcp",
  "version": "0.1.3",
  "description": "MCP server for the Overture Maps API \u2014 query places (POIs), buildings and administrative divisions from Overture Maps data inside Claude and other LLM tools.",
  "type": "module",
  "bin": {
    "overture-maps-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "overture",
    "overture-maps",
    "places",
    "poi",
    "geospatial",
    "gis",
    "claude",
    "llm"
  ],
  "author": "ThatAPICompany",
  "license": "MIT",
  "homepage": "https://www.overturemapsapi.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/thatapicompany/overture-maps-mcp"
  }
}
