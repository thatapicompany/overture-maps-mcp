{
  "name": "@thatapicompany/overture-maps-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Overture Maps API — query places (POIs), buildings and administrative divisions from Overture Maps data inside Claude and other LLM tools.",
  "type": "module",
  "bin": {
    "overture-maps-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "overture",
    "overture-maps",
    "places",
    "poi",
    "geospatial",
    "gis",
    "claude",
    "llm"
  ],
  "author": "ThatAPICompany",
  "license": "MIT",
  "homepage": "https://www.overturemapsapi.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/thatapicompany/overture-maps-mcp"
  }
}
